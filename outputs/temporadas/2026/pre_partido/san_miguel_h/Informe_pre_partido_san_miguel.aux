\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Rendimiento de San Miguel según la cancha. La columna roja (visitante) es la que nos toca: 1.0 punto por partido, con 7 empates en 10 salidas.}}{2}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Once más repetido de San Miguel. Nasta (5 goles) y Delgado (3) son la dupla ofensiva; Ceceri, el ancla defensiva; Oses, el mediocampista mejor puntuado.}}{2}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces xG y goles de San Miguel por tipo de jugada. Genera poco y casi todo por juego abierto; sufre en juego abierto (14 goles en contra) y en los laterales (3.6 de xG concedido).}}{3}{figure.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Goles recibidos por San Miguel según el minuto (20 partidos)}}{3}{table.1}\protected@file@percent }
