\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Cómo quedaron los números del partido (Chaco / Acassuso)}}{1}{table.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces El partido dividido en tramos de 15 minutos, según el peligro que generó cada equipo. Chaco (rojo) fue más peligroso en cinco de los seis tramos. El único donde Acassuso lo superó, y por mucho ($0.76$ a $0.26$), es el del 45 al 60: justo el ratito en el que llegó el empate.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:xg_tramos}{{1}{2}{El partido dividido en tramos de 15 minutos, según el peligro que generó cada equipo. Chaco (rojo) fue más peligroso en cinco de los seis tramos. El único donde Acassuso lo superó, y por mucho ($0.76$ a $0.26$), es el del 45 al 60: justo el ratito en el que llegó el empate}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces El pulso del partido minuto a minuto. Cuanto más grande la ola roja, más cerca estuvo Chaco del arco rival; la azul es Acassuso. El dominio de Chaco es casi permanente, con su pico en el 15-30 donde llegó el gol de Romero. El empate al 56' cae en uno de los poquitos avances de Acassuso de todo el segundo tiempo.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:momentum}{{2}{3}{El pulso del partido minuto a minuto. Cuanto más grande la ola roja, más cerca estuvo Chaco del arco rival; la azul es Acassuso. El dominio de Chaco es casi permanente, con su pico en el 15-30 donde llegó el gol de Romero. El empate al 56' cae en uno de los poquitos avances de Acassuso de todo el segundo tiempo}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Las notas de los jugadores. Romero arriba de todo con 8.1, seguido por Gaggi, Garay y Fernández con 7.4. El juego de ataque pasó por los dos refuerzos.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:ratings}{{3}{4}{Las notas de los jugadores. Romero arriba de todo con 8.1, seguido por Gaggi, Garay y Fernández con 7.4. El juego de ataque pasó por los dos refuerzos}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces En el Mapa de Calor podemos observar cómo en este partido Chaco tomó una posición más ofensiva y forzó un repliegue defensivo en Acassuso.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:heatmap}{{4}{5}{En el Mapa de Calor podemos observar cómo en este partido Chaco tomó una posición más ofensiva y forzó un repliegue defensivo en Acassuso}{figure.4}{}}
