\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Números del partido (Chaco / San Telmo)}}{1}{table.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces El partido dividido en tramos de 15 minutos, según el peligro (xG) que generó cada equipo. Chaco (rojo) tuvo sus picos en el 0-15 ($0.68$) y en el 75-90 ($0.78$), los dos tramos de sus goles. San Telmo (azul) no superó los $0.19$ de xG en ningún tramo.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:xg_tramos}{{1}{2}{El partido dividido en tramos de 15 minutos, según el peligro (xG) que generó cada equipo. Chaco (rojo) tuvo sus picos en el 0-15 ($0.68$) y en el 75-90 ($0.78$), los dos tramos de sus goles. San Telmo (azul) no superó los $0.19$ de xG en ningún tramo}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces El pulso del partido minuto a minuto: en azul los avances de San Telmo, en rojo los de Chaco. El área azul es mayoritaria (San Telmo tuvo el territorio). Los picos rojos coinciden con los minutos de los goles de Chaco (8-10' y 38'). El pico azul más marcado está apenas pasado el descanso, cuando San Telmo descontó (46').}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:momentum}{{2}{3}{El pulso del partido minuto a minuto: en azul los avances de San Telmo, en rojo los de Chaco. El área azul es mayoritaria (San Telmo tuvo el territorio). Los picos rojos coinciden con los minutos de los goles de Chaco (8-10' y 38'). El pico azul más marcado está apenas pasado el descanso, cuando San Telmo descontó (46')}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Las notas de los jugadores de Chaco. Romero arriba con $9.0$, seguido por Gaggi ($7.9$) y Canuto ($7.8$); Carrizo, el más bajo con $6.3$.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:ratings}{{3}{4}{Las notas de los jugadores de Chaco. Romero arriba con $9.0$, seguido por Gaggi ($7.9$) y Canuto ($7.8$); Carrizo, el más bajo con $6.3$}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Todos los remates del partido, separados por tipo y con el tamaño según su xG. Los dos remates rojos más grandes son los goles de Romero, dentro del área. Los de San Telmo (azul) se concentran en ``desviados'' y ``bloqueados'', casi todos de bajo xG.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:shotmap}{{4}{5}{Todos los remates del partido, separados por tipo y con el tamaño según su xG. Los dos remates rojos más grandes son los goles de Romero, dentro del área. Los de San Telmo (azul) se concentran en ``desviados'' y ``bloqueados'', casi todos de bajo xG}{figure.4}{}}
